generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN
  WORKSPACE_APP_ADMIN
  ITF_REGISTRATION_OFFICER
  ITF_COMPLIANCE_OFFICER
  ITF_TRAINING_APPROVER
  ITF_CLAIMS_REVIEWER
  ITF_CLAIMS_APPROVER
  ITF_AUDITOR
  AREA_MANAGER
  HORIC
  REVENUE_ACCOUNTANT
  HEAD_OF_TRAINING
  REIMBURSEMENT_OFFICER
  DIRECTOR_FSD
  HEAD_OF_DIVISION
  HQ_REIMBURSEMENT_OFFICER
  HQ_REVENUE_ACCOUNTANT
  DIRECTOR_GENERAL
  DIRECTOR_REVENUE_INSPECTORATE_COMPLIANCE
  HEAD_INSPECTORATE_COMPLIANCE
  EMPLOYER_ADMIN
  EMPLOYER_SUBMITTER
  EMPLOYER_VIEWER
}

enum AuthenticationSource {
  LOCAL
  GOOGLE
  WORKSPACE_SSO
}

enum OrganizationType {
  ITF_INTERNAL
  EMPLOYER
}

enum CompanyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  DEACTIVATED
  ARCHIVED
}

enum DocumentKind {
  CAC_CERTIFICATE
  TAX_CLEARANCE_CERTIFICATE
  AUDITED_ACCOUNT
  CONTRIBUTION_RECEIPT
  LEARNING_POLICY
  TRAINING_POLICY
  ANNUAL_TRAINING_PLAN
  TRAINING_PLAN_DOCUMENT
  LD_PERSONNEL_CV
  ATTENDANCE_SHEET
  PAYMENT_RECEIPT
  TRAINING_REPORT
  TRAINING_PHOTO
  CERTIFICATE
  CERTIFICATE_TEMPLATE_DESIGN
  SIGNATURE_IMAGE
  SIGNED_DECLARATION
  OFFICIAL_STAMPED_COPY
  OTHER_SUPPORTING_EVIDENCE
  CONTRIBUTION_INVOICE
}

enum StorageProvider {
  LOCAL
  VERCEL_BLOB
  S3
}

enum DocumentAccess {
  PRIVATE
  PUBLIC
}

enum DocumentScanStatus {
  PENDING_SCAN
  SAFE
  QUARANTINED
  REJECTED
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SETTLED
  ARCHIVED
}

enum ReimbursementEmployerScale {
  MEDIUM_LARGE
  SMALL
}

enum ReimbursementAwardArea {
  MANAGEMENT
  SUPERVISORY
  OCCUPATIONAL
  SMALL_SCALE_TRAINING
  LEARNING_DEVELOPMENT_PERSONNEL
  HEALTH_SAFETY_ENVIRONMENT
  SIWES
  TRAINING_PLAN
}

enum ReimbursementClaimLineStage {
  EMPLOYER
  AREA_OFFICE
  HEADQUARTERS
  AUDIT
}

enum ReimbursementStaffTrainingArea {
  MANAGEMENT
  SUPERVISORY
  OCCUPATIONAL
}

enum ReimbursementComputationTableStatus {
  DRAFT
  PREPARED
  CONFIRMED
}

enum ReimbursementPolicyEdition {
  EIGHTH_REVISED
}

enum RevenueWorkflowMode {
  EXTERNAL_VERIFICATION
  IN_APP_REVENUE
}

enum ContributionVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum ContributionVerificationSource {
  MANUAL
  EXTERNAL_SYSTEM
  IN_APP_REVENUE
}

enum ReimbursementClaimDesk {
  COMPANY
  AREA_MANAGER
  HEAD_OF_TRAINING
  REIMBURSEMENT_OFFICER
  DIRECTOR_FSD
  HEAD_OF_DIVISION
  HQ_REIMBURSEMENT_OFFICER
}

enum RegistrationApplicationKind {
  NEW_EMPLOYER
  LEGACY_EMPLOYER
}

enum RegistrationDesk {
  COMPANY
  AREA_MANAGER
  HORIC
  REVENUE_ACCOUNTANT
  DIRECTOR_FSD
  HEAD_OF_DIVISION
  DIRECTOR_REVENUE_INSPECTORATE_COMPLIANCE
  HEAD_INSPECTORATE_COMPLIANCE
  HQ_REVENUE_ACCOUNTANT
}

enum TrainingPlanDesk {
  COMPANY
  AREA_MANAGER
  HEAD_OF_TRAINING
  REIMBURSEMENT_OFFICER
}

enum TrainingRequestDesk {
  COMPANY
  AREA_MANAGER
  HEAD_OF_TRAINING
  REIMBURSEMENT_OFFICER
}

enum TrainingMonitoringMode {
  LOCAL_PHYSICAL
  LOCAL_VIRTUAL
}

enum TrainingDeliveryMode {
  LOCAL_PHYSICAL
  LOCAL_ONLINE
}

enum JurisdictionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TrainingMonitoringDesk {
  REIMBURSEMENT_OFFICER
  HEAD_OF_TRAINING
  AREA_MANAGER
  COMPANY
}

enum TrainingDecisionOutcome {
  ACCEPTED
  REJECTED
}

enum RecommendationReleaseChannel {
  DASHBOARD
  DASHBOARD_AND_EMAIL
}

enum ContributionInvoiceStatus {
  ISSUED
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  REMITA
}

enum ContributionPaymentStatus {
  INITIATED
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum RegistrationCertificateStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ManagedNumberType {
  ITF_EMPLOYER_NUMBER
  REGISTRATION_CERTIFICATE_NUMBER
  COMPLIANCE_CERTIFICATE_NUMBER
}

enum ManagedNumberStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  VOIDED
}

enum CertificateTemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum SignatureAssetKind {
  DIRECTOR_GENERAL_CE
  DIRECTOR_REVENUE_INSPECTORATE_COMPLIANCE
}

enum WorkspaceApp {
  REIMBURSEMENT
}

enum WorkItemKind {
  REGISTRATION_AREA_MANAGER_REVIEW
  REGISTRATION_AREA_OFFICE_REVIEW
  REGISTRATION_RECEIPT_REVIEW
  REGISTRATION_HQ_NOTIFICATION
  COMPLIANCE_AWARENESS
  COMPLIANCE_REVIEW
  REIMBURSEMENT_CLAIM_REVIEW
  TRAINING_PLAN_REVIEW
  TRAINING_REQUEST_REVIEW
  TRAINING_MONITORING_REVIEW
  TRAINING_FEEDBACK
  JURISDICTION_CHANGE_REVIEW
}

enum WorkItemStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WorkItemPriority {
  NORMAL
  HIGH
  URGENT
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum RecordTier {
  HOT
  WARM
  COLD
}

enum DecisionAction {
  SUBMIT
  FORWARD
  APPROVE
  REJECT
  REQUEST_CHANGES
  RECOMMEND
  CERTIFY
  SETTLE
  REOPEN
}

enum CommentVisibility {
  INTERNAL
  EMPLOYER_VISIBLE
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  REQUEST_CHANGES
  DEACTIVATE
  REVOKE
  ARCHIVE
  LOGIN
  UPLOAD_DOCUMENT
  REVOKE_DOCUMENT
  CHANGE_RECORD_TIER
  SETTLE
  REOPEN
}

model Workspace {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  externalId                 String?                     @unique
  allowLateClaimSubmissions  Boolean                     @default(false)
  activeReimbursementEdition ReimbursementPolicyEdition  @default(EIGHTH_REVISED)
  revenueWorkflowMode        RevenueWorkflowMode         @default(EXTERNAL_VERIFICATION)
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organizations              Organization[]
  areaOffices                AreaOffice[]
  memberships                Membership[]
  certificateTemplates       CertificateTemplate[]
  signatureAssets            SignatureAsset[]
  managedNumbers             ManagedRegistrationNumber[]
  workItems                  WorkItem[]
  auditEvents                AuditEvent[]
}

model AreaOffice {
  id                       String                               @id @default(cuid())
  workspaceId              String
  name                     String
  slug                     String
  code                     String?
  isActive                 Boolean                              @default(true)
  createdAt                DateTime                             @default(now())
  updatedAt                DateTime                             @updatedAt
  workspace                Workspace                            @relation(fields: [workspaceId], references: [id])
  companies                Company[]
  memberships              Membership[]
  registrationApplications RegistrationApplication[]
  contributionAssessments  RegistrationContributionAssessment[]
  workItems                WorkItem[]
  jurisdictionRequestsFrom JurisdictionChangeRequest[]          @relation("JurisdictionFromAreaOffice")
  jurisdictionRequestsTo   JurisdictionChangeRequest[]          @relation("JurisdictionToAreaOffice")

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
}

model Organization {
  id               String                   @id @default(cuid())
  workspaceId      String
  name             String
  slug             String
  organizationType OrganizationType         @default(EMPLOYER)
  externalId       String?
  isActive         Boolean                  @default(true)
  deactivatedAt    DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  workspace        Workspace                @relation(fields: [workspaceId], references: [id])
  companies        Company[]
  memberships      Membership[]
  documents        Document[]
  workItems        WorkItem[]
  auditEvents      AuditEvent[]
  invitations      OrganizationInvitation[]

  @@unique([workspaceId, slug])
}

model User {
  id                                               String                               @id @default(cuid())
  email                                            String                               @unique
  staffNumber                                      String?                              @unique
  name                                             String
  phoneNumber                                      String?
  department                                       String?
  jobTitle                                         String?
  passwordHash                                     String?
  emailVerifiedAt                                  DateTime?
  authenticationSource                             AuthenticationSource                 @default(LOCAL)
  mustChangePassword                               Boolean                              @default(false)
  provisionedAt                                    DateTime?
  welcomeEmailSentAt                               DateTime?
  lastSignedInAt                                   DateTime?
  isActive                                         Boolean                              @default(true)
  workflowEmailNotifications                       Boolean                              @default(true)
  isManagement                                     Boolean                              @default(false)
  calendarFeedEnabled                              Boolean                              @default(false)
  calendarFeedToken                                String?                              @unique
  createdAt                                        DateTime                             @default(now())
  updatedAt                                        DateTime                             @updatedAt
  memberships                                      Membership[]                         @relation("MembershipUser")
  deactivatedMemberships                           Membership[]                         @relation("MembershipDeactivatedBy")
  uploadedDocs                                     Document[]                           @relation("UploadedDocuments")
  submittedRegistrationApplications                RegistrationApplication[]            @relation("SubmittedRegistrationApplications")
  registrationContributionAssessments              RegistrationContributionAssessment[] @relation("RegistrationContributionAssessments")
  horicReviewedRegistrationContributionAssessments RegistrationContributionAssessment[] @relation("HoricReviewedRegistrationContributionAssessments")
  amReleasedRegistrationContributionAssessments    RegistrationContributionAssessment[] @relation("AmReleasedRegistrationContributionAssessments")
  issuedContributionInvoices                       ContributionInvoice[]                @relation("IssuedContributionInvoices")
  initiatedContributionPayments                    ContributionPayment[]                @relation("InitiatedContributionPayments")
  issuedRegistrationCertificates                   RegistrationCertificate[]            @relation("IssuedRegistrationCertificates")
  issuedComplianceCertificates                     ComplianceCertificate[]              @relation("IssuedComplianceCertificates")
  decisions                                        Decision[]
  comments                                         Comment[]
  assignedWorkItems                                WorkItem[]                           @relation("AssignedWorkItems")
  createdManagedNumbers                            ManagedRegistrationNumber[]          @relation("CreatedManagedNumbers")
  reservedManagedNumbers                           ManagedRegistrationNumber[]          @relation("ReservedManagedNumbers")
  issuedManagedNumbers                             ManagedRegistrationNumber[]          @relation("IssuedManagedNumbers")
  voidedManagedNumbers                             ManagedRegistrationNumber[]          @relation("VoidedManagedNumbers")
  auditEvents                                      AuditEvent[]
  emailVerificationTokens                          EmailVerificationToken[]
  passwordResetTokens                              PasswordResetToken[]
  sentOrganizationInvitations                      OrganizationInvitation[]             @relation("OrganizationInvitationInvitedBy")
  acceptedOrganizationInvitations                  OrganizationInvitation[]             @relation("OrganizationInvitationAcceptedBy")
  requestedJurisdictionChanges                     JurisdictionChangeRequest[]          @relation("JurisdictionRequestedBy")
  reviewedJurisdictionChanges                      JurisdictionChangeRequest[]          @relation("JurisdictionReviewedBy")
  contributionVerifiedClaims                       ReimbursementClaim[]                 @relation("ContributionVerifiedClaims")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model EmailDeliveryAttempt {
  id                String              @id @default(cuid())
  recipient         String
  subject           String
  provider          String
  status            EmailDeliveryStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  attemptedAt       DateTime            @default(now())
  completedAt       DateTime?

  @@index([recipient, attemptedAt])
  @@index([status, attemptedAt])
}

model Membership {
  id                String        @id @default(cuid())
  userId            String
  workspaceId       String
  organizationId    String?
  areaOfficeId      String?
  role              Role
  isActive          Boolean       @default(true)
  activatedAt       DateTime      @default(now())
  deactivatedAt     DateTime?
  deactivatedById   String?
  deactivatedReason String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation("MembershipUser", fields: [userId], references: [id])
  deactivatedBy     User?         @relation("MembershipDeactivatedBy", fields: [deactivatedById], references: [id])
  workspace         Workspace     @relation(fields: [workspaceId], references: [id])
  organization      Organization? @relation(fields: [organizationId], references: [id])
  areaOffice        AreaOffice?   @relation(fields: [areaOfficeId], references: [id])

  @@unique([userId, workspaceId, organizationId, role])
  @@index([areaOfficeId, role])
  @@index([organizationId, role, isActive])
  @@index([userId, isActive])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String       @unique
  invitedById    String
  acceptedById   String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  invitedBy      User         @relation("OrganizationInvitationInvitedBy", fields: [invitedById], references: [id])
  acceptedBy     User?        @relation("OrganizationInvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([organizationId, email, acceptedAt, revokedAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model Company {
  id                                  String                               @id @default(cuid())
  organizationId                      String
  areaOfficeId                        String?
  legalName                           String
  rcNumber                            String?
  taxId                               String?
  itfEmployerNumber                   String?
  businessAddress                     String?
  postalAddress                       String?
  email                               String?
  telephone                           String?
  natureOfBusiness                    String?
  establishedAt                       DateTime?
  payrollBasis                        Decimal?                             @db.Decimal(14, 2)
  status                              CompanyStatus                        @default(DRAFT)
  recordTier                          RecordTier                           @default(HOT)
  isActive                            Boolean                              @default(true)
  deactivatedAt                       DateTime?
  archivedAt                          DateTime?
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  organization                        Organization                         @relation(fields: [organizationId], references: [id])
  areaOffice                          AreaOffice?                          @relation(fields: [areaOfficeId], references: [id])
  documents                           Document[]
  complianceYears                     ComplianceYear[]
  complianceCertificates              ComplianceCertificate[]
  trainingPlanSubmissions             TrainingPlanSubmission[]
  trainingRequests                    TrainingRequest[]
  reimbursementClaims                 ReimbursementClaim[]
  jurisdictionChangeRequests          JurisdictionChangeRequest[]
  registrationApplication             RegistrationApplication?
  registrationContributionAssessments RegistrationContributionAssessment[]
  contributionInvoices                ContributionInvoice[]
  contributionPayments                ContributionPayment[]
  registrationCertificates            RegistrationCertificate[]
  managedNumbers                      ManagedRegistrationNumber[]
  workItems                           WorkItem[]
  decisions                           Decision[]
  comments                            Comment[]

  @@unique([itfEmployerNumber])
  @@index([organizationId, status, recordTier])
  @@index([areaOfficeId, status, recordTier])
}

model RegistrationApplication {
  id                       String                              @id @default(cuid())
  companyId                String                              @unique
  areaOfficeId             String
  submittedById            String?
  registrationKind         RegistrationApplicationKind         @default(NEW_EMPLOYER)
  claimedItfEmployerNumber String?
  status                   WorkflowStatus                      @default(DRAFT)
  currentDesk              RegistrationDesk                    @default(COMPANY)
  correctionReturnDesk     RegistrationDesk?
  submittedAt              DateTime?
  completedAt              DateTime?
  recordTier               RecordTier                          @default(HOT)
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt
  company                  Company                             @relation(fields: [companyId], references: [id])
  areaOffice               AreaOffice                          @relation(fields: [areaOfficeId], references: [id])
  submittedBy              User?                               @relation("SubmittedRegistrationApplications", fields: [submittedById], references: [id])
  decisions                Decision[]
  documents                Document[]
  workItems                WorkItem[]
  contributionAssessment   RegistrationContributionAssessment?
  contributionInvoice      ContributionInvoice?
  certificate              RegistrationCertificate?

  @@index([areaOfficeId, currentDesk, status, recordTier])
  @@index([registrationKind, status, recordTier])
  @@index([submittedById, recordTier])
}

model RegistrationCertificate {
  id                        String                        @id @default(cuid())
  companyId                 String
  registrationApplicationId String                        @unique
  issuedById                String
  certificateNumber         String                        @unique
  itfEmployerNumber         String
  templateId                String?
  generatedDocumentId       String?
  generatedAt               DateTime?
  status                    RegistrationCertificateStatus @default(ACTIVE)
  issuedAt                  DateTime                      @default(now())
  revokedAt                 DateTime?
  expiresAt                 DateTime?
  recordTier                RecordTier                    @default(HOT)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  company                   Company                       @relation(fields: [companyId], references: [id])
  registrationApplication   RegistrationApplication       @relation(fields: [registrationApplicationId], references: [id])
  issuedBy                  User                          @relation("IssuedRegistrationCertificates", fields: [issuedById], references: [id])
  template                  CertificateTemplate?          @relation(fields: [templateId], references: [id])
  managedNumbers            ManagedRegistrationNumber[]

  @@index([companyId, status, recordTier])
  @@index([issuedById, recordTier])
  @@index([templateId, status, recordTier])
  @@index([itfEmployerNumber])
}

model ManagedRegistrationNumber {
  id                              String                   @id @default(cuid())
  workspaceId                     String
  type                            ManagedNumberType
  value                           String
  status                          ManagedNumberStatus      @default(AVAILABLE)
  policyCode                      String?
  batchCode                       String?
  metadata                        Json?
  notes                           String?
  assignedCompanyId               String?
  assignedCertificateId           String?
  assignedComplianceCertificateId String?
  createdById                     String?
  reservedById                    String?
  reservedAt                      DateTime?
  issuedById                      String?
  issuedAt                        DateTime?
  voidedById                      String?
  voidedAt                        DateTime?
  voidReason                      String?
  recordTier                      RecordTier               @default(HOT)
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  workspace                       Workspace                @relation(fields: [workspaceId], references: [id])
  assignedCompany                 Company?                 @relation(fields: [assignedCompanyId], references: [id])
  assignedCertificate             RegistrationCertificate? @relation(fields: [assignedCertificateId], references: [id])
  assignedComplianceCertificate   ComplianceCertificate?   @relation(fields: [assignedComplianceCertificateId], references: [id])
  createdBy                       User?                    @relation("CreatedManagedNumbers", fields: [createdById], references: [id])
  reservedBy                      User?                    @relation("ReservedManagedNumbers", fields: [reservedById], references: [id])
  issuedBy                        User?                    @relation("IssuedManagedNumbers", fields: [issuedById], references: [id])
  voidedBy                        User?                    @relation("VoidedManagedNumbers", fields: [voidedById], references: [id])

  @@unique([workspaceId, type, value])
  @@index([workspaceId, type, status, recordTier])
  @@index([assignedCompanyId, type, status])
  @@index([assignedCertificateId])
  @@index([assignedComplianceCertificateId])
}

model CertificateTemplate {
  id                     String                    @id @default(cuid())
  workspaceId            String
  name                   String
  code                   String
  version                String
  status                 CertificateTemplateStatus @default(DRAFT)
  effectiveFrom          DateTime?
  retiredAt              DateTime?
  designDocumentId       String?
  placementMetadata      Json?
  notes                  String?
  recordTier             RecordTier                @default(HOT)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id])
  designDocument         Document?                 @relation("CertificateTemplateDesignDocument", fields: [designDocumentId], references: [id])
  certificates           RegistrationCertificate[]
  complianceCertificates ComplianceCertificate[]

  @@unique([workspaceId, code, version])
  @@index([designDocumentId])
  @@index([workspaceId, status, recordTier, effectiveFrom])
}

model SignatureAsset {
  id            String             @id @default(cuid())
  workspaceId   String
  documentId    String
  kind          SignatureAssetKind
  label         String
  effectiveFrom DateTime?
  retiredAt     DateTime?
  isActive      Boolean            @default(true)
  recordTier    RecordTier         @default(HOT)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  document      Document           @relation("SignatureAssetDocument", fields: [documentId], references: [id])

  @@index([workspaceId, kind, isActive, recordTier])
  @@index([documentId])
}

model RegistrationContributionAssessment {
  id                        String                        @id @default(cuid())
  registrationApplicationId String                        @unique
  companyId                 String
  areaOfficeId              String
  assessedById              String
  horicReviewedById         String?
  amReleasedById            String?
  payrollBasis              Decimal?                      @db.Decimal(14, 2)
  turnoverBasis             Decimal?                      @db.Decimal(14, 2)
  recommendedAmount         Decimal                       @db.Decimal(14, 2)
  assessmentNote            String?
  horicReviewNote           String?
  amReleaseNote             String?
  releaseChannel            RecommendationReleaseChannel?
  assessedAt                DateTime                      @default(now())
  horicReviewedAt           DateTime?
  amReleasedAt              DateTime?
  recordTier                RecordTier                    @default(HOT)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  registrationApplication   RegistrationApplication       @relation(fields: [registrationApplicationId], references: [id])
  company                   Company                       @relation(fields: [companyId], references: [id])
  areaOffice                AreaOffice                    @relation(fields: [areaOfficeId], references: [id])
  assessedBy                User                          @relation("RegistrationContributionAssessments", fields: [assessedById], references: [id])
  horicReviewedBy           User?                         @relation("HoricReviewedRegistrationContributionAssessments", fields: [horicReviewedById], references: [id])
  amReleasedBy              User?                         @relation("AmReleasedRegistrationContributionAssessments", fields: [amReleasedById], references: [id])
  invoice                   ContributionInvoice?

  @@index([companyId, recordTier])
  @@index([areaOfficeId, recordTier])
  @@index([assessedById, recordTier])
  @@index([horicReviewedById, recordTier])
  @@index([amReleasedById, recordTier])
}

model ContributionInvoice {
  id                        String                             @id @default(cuid())
  companyId                 String
  registrationApplicationId String                             @unique
  contributionAssessmentId  String                             @unique
  issuedById                String
  invoiceNumber             String                             @unique
  amount                    Decimal                            @db.Decimal(14, 2)
  status                    ContributionInvoiceStatus          @default(ISSUED)
  generatedDocumentId       String?
  generatedAt               DateTime?
  issuedAt                  DateTime                           @default(now())
  paidAt                    DateTime?
  cancelledAt               DateTime?
  recordTier                RecordTier                         @default(HOT)
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  company                   Company                            @relation(fields: [companyId], references: [id])
  registrationApplication   RegistrationApplication            @relation(fields: [registrationApplicationId], references: [id])
  contributionAssessment    RegistrationContributionAssessment @relation(fields: [contributionAssessmentId], references: [id])
  issuedBy                  User                               @relation("IssuedContributionInvoices", fields: [issuedById], references: [id])
  payments                  ContributionPayment[]

  @@index([companyId, status, recordTier])
  @@index([issuedById, recordTier])
}

model ContributionPayment {
  id                String                    @id @default(cuid())
  invoiceId         String
  companyId         String
  initiatedById     String
  provider          PaymentProvider           @default(REMITA)
  orderId           String                    @unique
  providerReference String?                   @unique
  amount            Decimal                   @db.Decimal(14, 2)
  status            ContributionPaymentStatus @default(INITIATED)
  statusCode        String?
  statusMessage     String?
  paymentUrl        String?
  initiatedAt       DateTime                  @default(now())
  lastCheckedAt     DateTime?
  confirmedAt       DateTime?
  recordTier        RecordTier                @default(HOT)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  invoice           ContributionInvoice       @relation(fields: [invoiceId], references: [id])
  company           Company                   @relation(fields: [companyId], references: [id])
  initiatedBy       User                      @relation("InitiatedContributionPayments", fields: [initiatedById], references: [id])

  @@unique([invoiceId, provider])
