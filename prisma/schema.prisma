generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN
  WORKSPACE_APP_ADMIN
  ITF_REGISTRATION_OFFICER
  ITF_COMPLIANCE_OFFICER
  ITF_TRAINING_APPROVER
  ITF_CLAIMS_REVIEWER
  ITF_CLAIMS_APPROVER
  ITF_AUDITOR
  AREA_MANAGER
  HORIC
  REVENUE_ACCOUNTANT
  HEAD_OF_TRAINING
  REIMBURSEMENT_OFFICER
  DIRECTOR_FSD
  HEAD_OF_DIVISION
  HQ_REIMBURSEMENT_OFFICER
  EMPLOYER_ADMIN
  EMPLOYER_SUBMITTER
  EMPLOYER_VIEWER
}

enum OrganizationType {
  ITF_INTERNAL
  EMPLOYER
}

enum CompanyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  DEACTIVATED
  ARCHIVED
}

enum DocumentKind {
  CAC_CERTIFICATE
  TAX_CLEARANCE_CERTIFICATE
  AUDITED_ACCOUNT
  CONTRIBUTION_RECEIPT
  LEARNING_POLICY
  TRAINING_POLICY
  ANNUAL_TRAINING_PLAN
  ATTENDANCE_SHEET
  PAYMENT_RECEIPT
  TRAINING_REPORT
  TRAINING_PHOTO
  CERTIFICATE
  SIGNED_DECLARATION
  OFFICIAL_STAMPED_COPY
  OTHER_SUPPORTING_EVIDENCE
}

enum StorageProvider {
  LOCAL
  VERCEL_BLOB
  S3
}

enum DocumentAccess {
  PRIVATE
  PUBLIC
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SETTLED
  ARCHIVED
}

enum RegistrationDesk {
  COMPANY
  AREA_MANAGER
  HORIC
  REVENUE_ACCOUNTANT
  DIRECTOR_FSD
  HEAD_OF_DIVISION
}

enum RecommendationReleaseChannel {
  DASHBOARD
  DASHBOARD_AND_EMAIL
}

enum WorkspaceApp {
  REIMBURSEMENT
}

enum WorkItemKind {
  REGISTRATION_RECEIPT_REVIEW
  REGISTRATION_HQ_NOTIFICATION
}

enum WorkItemStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WorkItemPriority {
  NORMAL
  HIGH
  URGENT
}

enum RecordTier {
  HOT
  WARM
  COLD
}

enum DecisionAction {
  SUBMIT
  FORWARD
  APPROVE
  REJECT
  REQUEST_CHANGES
  RECOMMEND
  CERTIFY
  SETTLE
  REOPEN
}

enum CommentVisibility {
  INTERNAL
  EMPLOYER_VISIBLE
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  REQUEST_CHANGES
  DEACTIVATE
  REVOKE
  ARCHIVE
  LOGIN
  UPLOAD_DOCUMENT
  REVOKE_DOCUMENT
  CHANGE_RECORD_TIER
  SETTLE
  REOPEN
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  externalId    String?        @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
  areaOffices   AreaOffice[]
  memberships   Membership[]
  workItems     WorkItem[]
  auditEvents   AuditEvent[]
}

model AreaOffice {
  id                       String                               @id @default(cuid())
  workspaceId              String
  name                     String
  slug                     String
  code                     String?
  isActive                 Boolean                              @default(true)
  createdAt                DateTime                             @default(now())
  updatedAt                DateTime                             @updatedAt
  workspace                Workspace                            @relation(fields: [workspaceId], references: [id])
  companies                Company[]
  memberships              Membership[]
  registrationApplications RegistrationApplication[]
  contributionAssessments  RegistrationContributionAssessment[]
  workItems                WorkItem[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
}

model Organization {
  id               String           @id @default(cuid())
  workspaceId      String
  name             String
  slug             String
  organizationType OrganizationType @default(EMPLOYER)
  externalId       String?
  isActive         Boolean          @default(true)
  deactivatedAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id])
  companies        Company[]
  memberships      Membership[]
  documents        Document[]
  workItems        WorkItem[]
  auditEvents      AuditEvent[]

  @@unique([workspaceId, slug])
}

model User {
  id                                               String                               @id @default(cuid())
  email                                            String                               @unique
  name                                             String
  isActive                                         Boolean                              @default(true)
  createdAt                                        DateTime                             @default(now())
  updatedAt                                        DateTime                             @updatedAt
  memberships                                      Membership[]
  uploadedDocs                                     Document[]                           @relation("UploadedDocuments")
  submittedRegistrationApplications                RegistrationApplication[]            @relation("SubmittedRegistrationApplications")
  registrationContributionAssessments              RegistrationContributionAssessment[] @relation("RegistrationContributionAssessments")
  horicReviewedRegistrationContributionAssessments RegistrationContributionAssessment[] @relation("HoricReviewedRegistrationContributionAssessments")
  amReleasedRegistrationContributionAssessments    RegistrationContributionAssessment[] @relation("AmReleasedRegistrationContributionAssessments")
  decisions                                        Decision[]
  comments                                         Comment[]
  assignedWorkItems                                WorkItem[]                           @relation("AssignedWorkItems")
  auditEvents                                      AuditEvent[]
}

model Membership {
  id             String        @id @default(cuid())
  userId         String
  workspaceId    String
  organizationId String?
  areaOfficeId   String?
  role           Role
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  areaOffice     AreaOffice?   @relation(fields: [areaOfficeId], references: [id])

  @@unique([userId, workspaceId, organizationId, role])
  @@index([areaOfficeId, role])
}

model Company {
  id                                  String                               @id @default(cuid())
  organizationId                      String
  areaOfficeId                        String?
  legalName                           String
  rcNumber                            String?
  taxId                               String?
  itfEmployerNumber                   String?
  businessAddress                     String?
  postalAddress                       String?
  email                               String?
  telephone                           String?
  natureOfBusiness                    String?
  establishedAt                       DateTime?
  payrollBasis                        Decimal?                             @db.Decimal(14, 2)
  status                              CompanyStatus                        @default(DRAFT)
  recordTier                          RecordTier                           @default(HOT)
  isActive                            Boolean                              @default(true)
  deactivatedAt                       DateTime?
  archivedAt                          DateTime?
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  organization                        Organization                         @relation(fields: [organizationId], references: [id])
  areaOffice                          AreaOffice?                          @relation(fields: [areaOfficeId], references: [id])
  documents                           Document[]
  complianceYears                     ComplianceYear[]
  trainingRequests                    TrainingRequest[]
  reimbursementClaims                 ReimbursementClaim[]
  registrationApplication             RegistrationApplication?
  registrationContributionAssessments RegistrationContributionAssessment[]
  workItems                           WorkItem[]
  decisions                           Decision[]
  comments                            Comment[]

  @@unique([itfEmployerNumber])
  @@index([organizationId, status, recordTier])
  @@index([areaOfficeId, status, recordTier])
}

model RegistrationApplication {
  id                     String                              @id @default(cuid())
  companyId              String                              @unique
  areaOfficeId           String
  submittedById          String?
  status                 WorkflowStatus                      @default(DRAFT)
  currentDesk            RegistrationDesk                    @default(COMPANY)
  submittedAt            DateTime?
  completedAt            DateTime?
  recordTier             RecordTier                          @default(HOT)
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  company                Company                             @relation(fields: [companyId], references: [id])
  areaOffice             AreaOffice                          @relation(fields: [areaOfficeId], references: [id])
  submittedBy            User?                               @relation("SubmittedRegistrationApplications", fields: [submittedById], references: [id])
  decisions              Decision[]
  documents              Document[]
  workItems              WorkItem[]
  contributionAssessment RegistrationContributionAssessment?

  @@index([areaOfficeId, currentDesk, status, recordTier])
  @@index([submittedById, recordTier])
}

model RegistrationContributionAssessment {
  id                        String                        @id @default(cuid())
  registrationApplicationId String                        @unique
  companyId                 String
  areaOfficeId              String
  assessedById              String
  horicReviewedById         String?
  amReleasedById            String?
  payrollBasis              Decimal?                      @db.Decimal(14, 2)
  turnoverBasis             Decimal?                      @db.Decimal(14, 2)
  recommendedAmount         Decimal                       @db.Decimal(14, 2)
  assessmentNote            String?
  horicReviewNote           String?
  amReleaseNote             String?
  releaseChannel            RecommendationReleaseChannel?
  assessedAt                DateTime                      @default(now())
  horicReviewedAt           DateTime?
  amReleasedAt              DateTime?
  recordTier                RecordTier                    @default(HOT)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  registrationApplication   RegistrationApplication       @relation(fields: [registrationApplicationId], references: [id])
  company                   Company                       @relation(fields: [companyId], references: [id])
  areaOffice                AreaOffice                    @relation(fields: [areaOfficeId], references: [id])
  assessedBy                User                          @relation("RegistrationContributionAssessments", fields: [assessedById], references: [id])
  horicReviewedBy           User?                         @relation("HoricReviewedRegistrationContributionAssessments", fields: [horicReviewedById], references: [id])
  amReleasedBy              User?                         @relation("AmReleasedRegistrationContributionAssessments", fields: [amReleasedById], references: [id])

  @@index([companyId, recordTier])
  @@index([areaOfficeId, recordTier])
  @@index([assessedById, recordTier])
  @@index([horicReviewedById, recordTier])
  @@index([amReleasedById, recordTier])
}

model ComplianceYear {
  id                      String                   @id @default(cuid())
  companyId               String
  year                    Int
  nigerianEmployeeCount   Int?
  expatriateEmployeeCount Int?
  totalEmployeeCount      Int?
  turnover                Decimal?                 @db.Decimal(14, 2)
  payrollTotal            Decimal?                 @db.Decimal(14, 2)
  contributionAmount      Decimal?                 @db.Decimal(14, 2)
  amountPaid              Decimal?                 @db.Decimal(14, 2)
  amountPaidInWords       String?
  paymentMode             String?
  contributionPaidAt      DateTime?
  annualPlanSubmittedAt   DateTime?
  declarationName         String?
  declarationPosition     String?
  declarationPhone        String?
  declaredAt              DateTime?
  status                  WorkflowStatus           @default(DRAFT)
  recordTier              RecordTier               @default(HOT)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  company                 Company                  @relation(fields: [companyId], references: [id])
  documents               Document[]
  branchReturns           ComplianceBranchReturn[]
  decisions               Decision[]
  comments                Comment[]

  @@unique([companyId, year])
  @@index([companyId, status, recordTier])
}

model ComplianceBranchReturn {
  id               String         @id @default(cuid())
  complianceYearId String
  address          String
  employeeCount    Int?
  payrollTotal     Decimal?       @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  complianceYear   ComplianceYear @relation(fields: [complianceYearId], references: [id])

  @@index([complianceYearId])
}

model TrainingRequest {
  id                   String                @id @default(cuid())
  companyId            String
  title                String
  description          String?
  trainingType         String?
  provider             String
  venue                String?
  startsAt             DateTime
  endsAt               DateTime
  participantCount     Int?
  estimatedCost        Decimal               @db.Decimal(14, 2)
  expectedOutcome      String?
  approvalReference    String?
  approvedOriginalRef  String?
  approvedDuplicateRef String?
  status               WorkflowStatus        @default(DRAFT)
  recordTier           RecordTier            @default(HOT)
  submittedAt          DateTime?
  approvedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  company              Company               @relation(fields: [companyId], references: [id])
  documents            Document[]
  participants         TrainingParticipant[]
  claims               ReimbursementClaim[]
  decisions            Decision[]
  comments             Comment[]

  @@index([companyId, status, recordTier])
}

model TrainingParticipant {
  id                       String          @id @default(cuid())
  trainingRequestId        String
  name                     String
  trainingArea             String?
  educationalQualification String?
  jobTitle                 String?
  nationality              String?
  courseTitle              String?
  courseSynopsis           String?
  courseOrganiser          String?
  venue                    String?
  startsAt                 DateTime?
  endsAt                   DateTime?
  approvalRemarks          String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  trainingRequest          TrainingRequest @relation(fields: [trainingRequestId], references: [id])

  @@index([trainingRequestId])
}

model ReimbursementClaim {
  id                       String                   @id @default(cuid())
  companyId                String
  trainingRequestId        String?
  reference                String                   @unique
  claimYear                Int?
  trainingContributionDue  Decimal?                 @db.Decimal(14, 2)
  trainingContributionPaid Decimal?                 @db.Decimal(14, 2)
  maxReimbursableAmount    Decimal?                 @db.Decimal(14, 2)
  itfReceiptNumber         String?
  bankName                 String?
  accountNumber            String?
  sortCode                 String?
  claimedAmount            Decimal                  @db.Decimal(14, 2)
  eligibleAmount           Decimal?                 @db.Decimal(14, 2)
  claimRecommendedAmount   Decimal?                 @db.Decimal(14, 2)
  claimRecommendedInWords  String?
  paymentDetails           String?
  employerOfficerName      String?
  employerOfficerRank      String?
  chiefExecutiveName       String?
  employerDeclaredAt       DateTime?
  status                   WorkflowStatus           @default(DRAFT)
  recordTier               RecordTier               @default(HOT)
  submittedAt              DateTime?
  settledAt                DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  company                  Company                  @relation(fields: [companyId], references: [id])
  trainingRequest          TrainingRequest?         @relation(fields: [trainingRequestId], references: [id])
  documents                Document[]
  lines                    ReimbursementClaimLine[]
  decisions                Decision[]
  comments                 Comment[]

  @@index([companyId, status, recordTier])
}

model ReimbursementClaimLine {
  id                   String             @id @default(cuid())
  reimbursementClaimId String
  trainingArea         String
  totalWorkforce       Int?
  totalTrained         Int?
  percentTrained       Decimal?           @db.Decimal(5, 2)
  emphasisNumber       Int?
  contributionPaid     Decimal?           @db.Decimal(14, 2)
  employerClaimAmount  Decimal?           @db.Decimal(14, 2)
  referencePage        String?
  percentAwarded       Decimal?           @db.Decimal(5, 2)
  amountAwarded        Decimal?           @db.Decimal(14, 2)
  remarks              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  reimbursementClaim   ReimbursementClaim @relation(fields: [reimbursementClaimId], references: [id])

  @@index([reimbursementClaimId])
}

model Document {
  id                        String                   @id @default(cuid())
  organizationId            String
  companyId                 String?
  registrationApplicationId String?
  complianceYearId          String?
  trainingRequestId         String?
  reimbursementClaimId      String?
  uploadedById              String
  kind                      DocumentKind
  fileName                  String
  storageProvider           StorageProvider
  bucket                    String?
  objectKey                 String
  url                       String?
  etag                      String?
  versionId                 String?
  checksum                  String
  mimeType                  String
  fileSize                  Int
  access                    DocumentAccess           @default(PRIVATE)
  classification            String                   @default("OFFICIAL")
  retentionPolicy           String?
  expiresAt                 DateTime?
  revokedAt                 DateTime?
  recordTier                RecordTier               @default(HOT)
  isActive                  Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  organization              Organization             @relation(fields: [organizationId], references: [id])
  company                   Company?                 @relation(fields: [companyId], references: [id])
  registrationApplication   RegistrationApplication? @relation(fields: [registrationApplicationId], references: [id])
  complianceYear            ComplianceYear?          @relation(fields: [complianceYearId], references: [id])
  trainingRequest           TrainingRequest?         @relation(fields: [trainingRequestId], references: [id])
  reimbursementClaim        ReimbursementClaim?      @relation(fields: [reimbursementClaimId], references: [id])
  uploadedBy                User                     @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  decisions                 Decision[]
  comments                  Comment[]

  @@index([organizationId, kind, recordTier, isActive])
  @@index([registrationApplicationId, kind, recordTier, isActive])
}

model Decision {
  id                        String                   @id @default(cuid())
  actorId                   String
  companyId                 String?
  registrationApplicationId String?
  complianceYearId          String?
  trainingRequestId         String?
  reimbursementClaimId      String?
  documentId                String?
  action                    DecisionAction
  reason                    String?
  recordTier                RecordTier               @default(HOT)
  createdAt                 DateTime                 @default(now())
  actor                     User                     @relation(fields: [actorId], references: [id])
  company                   Company?                 @relation(fields: [companyId], references: [id])
  registrationApplication   RegistrationApplication? @relation(fields: [registrationApplicationId], references: [id])
  complianceYear            ComplianceYear?          @relation(fields: [complianceYearId], references: [id])
  trainingRequest           TrainingRequest?         @relation(fields: [trainingRequestId], references: [id])
  reimbursementClaim        ReimbursementClaim?      @relation(fields: [reimbursementClaimId], references: [id])
  document                  Document?                @relation(fields: [documentId], references: [id])

  @@index([actorId, recordTier, createdAt])
  @@index([registrationApplicationId, recordTier, createdAt])
}

model Comment {
  id                   String              @id @default(cuid())
  actorId              String
  companyId            String?
  complianceYearId     String?
  trainingRequestId    String?
  reimbursementClaimId String?
  documentId           String?
  body                 String
  visibility           CommentVisibility   @default(INTERNAL)
  recordTier           RecordTier          @default(HOT)
  createdAt            DateTime            @default(now())
  actor                User                @relation(fields: [actorId], references: [id])
  company              Company?            @relation(fields: [companyId], references: [id])
  complianceYear       ComplianceYear?     @relation(fields: [complianceYearId], references: [id])
  trainingRequest      TrainingRequest?    @relation(fields: [trainingRequestId], references: [id])
  reimbursementClaim   ReimbursementClaim? @relation(fields: [reimbursementClaimId], references: [id])
  document             Document?           @relation(fields: [documentId], references: [id])

  @@index([actorId, recordTier, createdAt])
}

model WorkItem {
  id                        String                   @id @default(cuid())
  workspaceId               String
  organizationId            String?
  areaOfficeId              String?
  companyId                 String?
  registrationApplicationId String?
  assignedUserId            String?
  assignedRole              Role?
  app                       WorkspaceApp             @default(REIMBURSEMENT)
  kind                      WorkItemKind
  status                    WorkItemStatus           @default(OPEN)
  priority                  WorkItemPriority         @default(NORMAL)
  title                     String
  summary                   String?
  targetHref                String
  sourceKey                 String                   @unique
  resolvedAt                DateTime?
  recordTier                RecordTier               @default(HOT)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  workspace                 Workspace                @relation(fields: [workspaceId], references: [id])
  organization              Organization?            @relation(fields: [organizationId], references: [id])
  areaOffice                AreaOffice?              @relation(fields: [areaOfficeId], references: [id])
  company                   Company?                 @relation(fields: [companyId], references: [id])
  registrationApplication   RegistrationApplication? @relation(fields: [registrationApplicationId], references: [id])
  assignedUser              User?                    @relation("AssignedWorkItems", fields: [assignedUserId], references: [id])

  @@index([workspaceId, app, status, recordTier, createdAt])
  @@index([areaOfficeId, assignedRole, status, recordTier])
  @@index([organizationId, status, recordTier])
  @@index([assignedUserId, status, recordTier])
}

model AuditEvent {
  id             String        @id @default(cuid())
  workspaceId    String
  organizationId String?
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String
  reason         String?
  metadata       Json?
  recordTier     RecordTier    @default(HOT)
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation(fields: [actorId], references: [id])

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([workspaceId, recordTier, createdAt])
}
