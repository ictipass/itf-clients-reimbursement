generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN
  WORKSPACE_APP_ADMIN
  ITF_REGISTRATION_OFFICER
  ITF_COMPLIANCE_OFFICER
  ITF_TRAINING_APPROVER
  ITF_CLAIMS_REVIEWER
  ITF_CLAIMS_APPROVER
  ITF_AUDITOR
  EMPLOYER_ADMIN
  EMPLOYER_SUBMITTER
  EMPLOYER_VIEWER
}

enum OrganizationType {
  ITF_INTERNAL
  EMPLOYER
}

enum CompanyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  DEACTIVATED
  ARCHIVED
}

enum DocumentKind {
  CAC_CERTIFICATE
  TAX_CLEARANCE_CERTIFICATE
  AUDITED_ACCOUNT
  FORM_7A
  CONTRIBUTION_RECEIPT
  LEARNING_POLICY
  TRAINING_POLICY
  ANNUAL_TRAINING_PLAN
  FORM_4A
  CLAIM_COVER_LETTER
  FORM_1A
  FORM_1B
  FORM_2A
  FORM_2B
  FORM_3A
  FORM_5A
  ATTENDANCE_SHEET
  PAYMENT_RECEIPT
  TRAINING_REPORT
  TRAINING_PHOTO
  CERTIFICATE
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SETTLED
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  REQUEST_CHANGES
  DEACTIVATE
  REVOKE
  ARCHIVE
  LOGIN
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  externalId    String?        @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
  memberships   Membership[]
  auditEvents   AuditEvent[]
}

model Organization {
  id               String           @id @default(cuid())
  workspaceId      String
  name             String
  slug             String
  organizationType OrganizationType @default(EMPLOYER)
  externalId       String?
  isActive         Boolean          @default(true)
  deactivatedAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id])
  companies        Company[]
  memberships      Membership[]
  documents        Document[]
  auditEvents      AuditEvent[]

  @@unique([workspaceId, slug])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  uploadedDocs Document[]   @relation("UploadedDocuments")
  decisions    Decision[]
  comments     Comment[]
  auditEvents  AuditEvent[]
}

model Membership {
  id             String        @id @default(cuid())
  userId         String
  workspaceId    String
  organizationId String?
  role           Role
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, workspaceId, organizationId, role])
}

model Company {
  id                  String               @id @default(cuid())
  organizationId      String
  legalName           String
  rcNumber            String?
  taxId               String?
  itfEmployerNumber   String?
  businessAddress     String?
  postalAddress       String?
  email               String?
  telephone           String?
  natureOfBusiness    String?
  establishedAt       DateTime?
  payrollBasis        Decimal?             @db.Decimal(14, 2)
  status              CompanyStatus        @default(DRAFT)
  isActive            Boolean              @default(true)
  deactivatedAt       DateTime?
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id])
  documents           Document[]
  complianceYears     ComplianceYear[]
  trainingRequests    TrainingRequest[]
  reimbursementClaims ReimbursementClaim[]
  decisions           Decision[]
  comments            Comment[]

  @@index([organizationId, status])
}

model ComplianceYear {
  id                    String         @id @default(cuid())
  companyId             String
  year                  Int
  nigerianEmployeeCount Int?
  expatriateEmployeeCount Int?
  totalEmployeeCount    Int?
  turnover              Decimal?       @db.Decimal(14, 2)
  payrollTotal          Decimal?       @db.Decimal(14, 2)
  contributionAmount    Decimal?       @db.Decimal(14, 2)
  amountPaid            Decimal?       @db.Decimal(14, 2)
  amountPaidInWords     String?
  paymentMode           String?
  contributionPaidAt    DateTime?
  annualPlanSubmittedAt DateTime?
  declarationName       String?
  declarationPosition   String?
  declarationPhone      String?
  declaredAt            DateTime?
  status                WorkflowStatus @default(DRAFT)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  company               Company        @relation(fields: [companyId], references: [id])
  documents             Document[]
  branchReturns         ComplianceBranchReturn[]

  @@unique([companyId, year])
}

model ComplianceBranchReturn {
  id               String         @id @default(cuid())
  complianceYearId String
  address          String
  employeeCount    Int?
  payrollTotal     Decimal?       @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  complianceYear   ComplianceYear @relation(fields: [complianceYearId], references: [id])
}

model TrainingRequest {
  id            String               @id @default(cuid())
  companyId     String
  title         String
  provider      String
  venue         String?
  startsAt      DateTime
  endsAt        DateTime
  estimatedCost Decimal              @db.Decimal(14, 2)
  status        WorkflowStatus       @default(DRAFT)
  submittedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       Company              @relation(fields: [companyId], references: [id])
  documents     Document[]
  claims        ReimbursementClaim[]
  decisions     Decision[]
  comments      Comment[]
}

model ReimbursementClaim {
  id                String           @id @default(cuid())
  companyId         String
  trainingRequestId String?
  reference         String           @unique
  claimedAmount     Decimal          @db.Decimal(14, 2)
  eligibleAmount    Decimal?         @db.Decimal(14, 2)
  status            WorkflowStatus   @default(DRAFT)
  submittedAt       DateTime?
  settledAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id])
  trainingRequest   TrainingRequest? @relation(fields: [trainingRequestId], references: [id])
  documents         Document[]
  decisions         Decision[]
  comments          Comment[]
}

model Document {
  id                   String              @id @default(cuid())
  organizationId       String
  companyId            String?
  complianceYearId     String?
  trainingRequestId    String?
  reimbursementClaimId String?
  uploadedById         String
  kind                 DocumentKind
  fileName             String
  objectKey            String
  checksum             String
  mimeType             String
  fileSize             Int
  classification       String              @default("OFFICIAL")
  retentionPolicy      String?
  expiresAt            DateTime?
  revokedAt            DateTime?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  organization         Organization        @relation(fields: [organizationId], references: [id])
  company              Company?            @relation(fields: [companyId], references: [id])
  complianceYear       ComplianceYear?     @relation(fields: [complianceYearId], references: [id])
  trainingRequest      TrainingRequest?    @relation(fields: [trainingRequestId], references: [id])
  reimbursementClaim   ReimbursementClaim? @relation(fields: [reimbursementClaimId], references: [id])
  uploadedBy           User                @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([organizationId, kind, isActive])
}

model Decision {
  id                   String              @id @default(cuid())
  actorId              String
  companyId            String?
  trainingRequestId    String?
  reimbursementClaimId String?
  action               WorkflowStatus
  reason               String?
  createdAt            DateTime            @default(now())
  actor                User                @relation(fields: [actorId], references: [id])
  company              Company?            @relation(fields: [companyId], references: [id])
  trainingRequest      TrainingRequest?    @relation(fields: [trainingRequestId], references: [id])
  reimbursementClaim   ReimbursementClaim? @relation(fields: [reimbursementClaimId], references: [id])
}

model Comment {
  id                   String              @id @default(cuid())
  actorId              String
  companyId            String?
  trainingRequestId    String?
  reimbursementClaimId String?
  body                 String
  createdAt            DateTime            @default(now())
  actor                User                @relation(fields: [actorId], references: [id])
  company              Company?            @relation(fields: [companyId], references: [id])
  trainingRequest      TrainingRequest?    @relation(fields: [trainingRequestId], references: [id])
  reimbursementClaim   ReimbursementClaim? @relation(fields: [reimbursementClaimId], references: [id])
}

model AuditEvent {
  id             String        @id @default(cuid())
  workspaceId    String
  organizationId String?
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String
  reason         String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation(fields: [actorId], references: [id])

  @@index([workspaceId, entityType, entityId, createdAt])
}
