# PostgreSQL connection string used by Prisma.
# Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itf_reimbursement?schema=public"
DATABASE_URL=""

# NextAuth secret used to sign session tokens.
# Generate a local value with:
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# Local app URL used by Auth.js callbacks.
NEXTAUTH_URL="http://localhost:3000"

# Temporary bootstrap admin credentials for local development.
# Replace before any shared environment.
BOOTSTRAP_ADMIN_ID="system-admin"
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@itf.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
BOOTSTRAP_ADMIN_ROLE="SYSTEM_ADMIN"
