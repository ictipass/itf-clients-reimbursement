# PostgreSQL connection string used by Prisma.
# Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itf_reimbursement?schema=public"
DATABASE_URL=""

# NextAuth secret used to sign session tokens.
# Generate a local value with:
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional shared rate limiter for multi-instance deployments.
# Without these values, development uses the in-memory fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Local app URL used by Auth.js callbacks.
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth. Verified new Google identities become employer portal accounts.
# Existing ITF directory identities retain their assigned roles.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL used inside certificate QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email delivery.
# development_link: show links in the UI without sending email (development only)
# resend_and_development_link: send through Resend and also show links (development only)
# resend: send through Resend and never expose private links in the UI (required in production)
EMAIL_DELIVERY_MODE="development_link"
RESEND_API_KEY=""
EMAIL_FROM="ITF Reimbursement <onboarding@resend.dev>"
CRON_SECRET=""

# Temporary bootstrap admin credentials for local development.
# Replace before any shared environment.
BOOTSTRAP_ADMIN_ID="system-admin"
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@itf.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
BOOTSTRAP_ADMIN_ROLE="SYSTEM_ADMIN"

# Shared local-only password for seeded role test accounts.
# Ignored in production by the credentials provider.
DEV_TEST_USER_PASSWORD="password123"

# Optional seed labels for local/dev foundation data.
SEED_WORKSPACE_ID="itf-workspace"
SEED_WORKSPACE_NAME="ITF Workspace"
SEED_WORKSPACE_SLUG="itf-workspace"
SEED_ITF_ORGANIZATION_ID="itf-internal"
SEED_ITF_ORGANIZATION_NAME="Industrial Training Fund"
SEED_ITF_ORGANIZATION_SLUG="itf"
SEED_EMPLOYER_ORGANIZATION_ID="demo-employer"
SEED_EMPLOYER_ORGANIZATION_NAME="Demo Employer Organization"
SEED_EMPLOYER_ORGANIZATION_SLUG="demo-employer"

# Upload storage provider for new documents.
# Supported values: "local", "vercel_blob", or "s3"
STORAGE_PROVIDER="local"

# "local" scans known test/active-content markers; "quarantine" holds every upload for manual review.
MALWARE_SCANNER_PROVIDER="local"

# Required when STORAGE_PROVIDER="local".
# Files are stored outside /public and should not be served directly.
LOCAL_STORAGE_ROOT="storage/uploads"

# Required when STORAGE_PROVIDER="vercel_blob".
BLOB_READ_WRITE_TOKEN=""

# Required when STORAGE_PROVIDER="s3".
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional for S3-compatible providers such as Cloudflare R2, MinIO, or Spaces.
S3_ENDPOINT=""

# Remita merchant integration. Obtain exact URLs/templates and success codes from ITF's
# approved Remita onboarding pack before enabling payments.
REMITA_MERCHANT_ID=""
REMITA_API_KEY=""
REMITA_SERVICE_TYPE_ID=""
REMITA_PAYMENT_INIT_URL=""
REMITA_STATUS_URL_TEMPLATE=""
REMITA_PAYMENT_URL_TEMPLATE=""
REMITA_AUTHORIZATION_TEMPLATE=""
REMITA_SUCCESS_CODES=""
